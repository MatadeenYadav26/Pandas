        "# Convert numeric marks to grades\n",
        "def to_grade(score):\n",
        "    if score >= 90:\n",
        "        return \"A\"\n",
        "    elif score >= 80:\n",
        "        return \"B\"\n",
        "    elif score >= 70:\n",
        "        return \"C\"\n",
        "    else:\n",
        "        return \"D\"\n",
        "\n",
        "df[\"MathGrade\"] = df[\"Math\"].apply(to_grade)\n",
        "print(\"\\nGrades for Math using apply():\")\n",
        "print(df[[\"Name\", \"Math\", \"MathGrade\"]])\n"
      ]
